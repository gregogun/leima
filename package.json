{
  "name": "leima",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Realistic perforated postage stamps from a seeded config",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --recursive build",
    "dev": "pnpm --recursive --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "pnpm --recursive exec rm -rf dist .turbo node_modules/.cache"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
